{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tooth-fairy-dentistry.onrender.com/api/:path*" },
    { "source": "/img/:path*", "destination": "https://tooth-fairy-dentistry.onrender.com/img/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
